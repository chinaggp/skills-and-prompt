        </Canvas>

        <Canvas x:Name="CoreVisual"
                Width="160"
                Height="160"
                Canvas.Left="180"
                Canvas.Top="180"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="CoreScale" ScaleX="1" ScaleY="1" />
            </Canvas.RenderTransform>
            <Ellipse Width="132" Height="132" Canvas.Left="14" Canvas.Top="14">
                <Ellipse.Fill>#FF000000</Ellipse.Fill>
            </Ellipse>
            <Path Data="M 33,110 C 58,133 107,137 132,104"
                  Stroke="#16FF9A42"
                  StrokeThickness="2">
                <Path.Effect>
                    <BlurEffect Radius="5" />
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- Foreground matter crosses the core and creates the diagonal cinematic silhouette. -->
        <Canvas x:Name="ForegroundDisk"
                Width="520"
                Height="520"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ForegroundScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="ForegroundSkew" />
                    <RotateTransform x:Name="ForegroundRotation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Path Data="M 39,349 C 130,336 204,312 262,287 C 335,255 406,234 488,218"
                  Stroke="#47FF6F1A"
                  StrokeThickness="36"
                  Opacity="0.82">
                <Path.Effect>
                    <BlurEffect Radius="25" />
                </Path.Effect>
            </Path>
            <Path Data="M 43,347 C 134,335 203,313 263,287 C 337,255 409,234 486,219"
                  Stroke="{StaticResource HotMatterBrush}"
                  StrokeThickness="15"
                  Opacity="0.96">
                <Path.Effect>
                    <BlurEffect Radius="6" />
                </Path.Effect>
            </Path>
            <Path Data="M 48,342 C 139,330 207,309 264,284 C 338,251 408,232 481,220"
                  Stroke="{StaticResource WhiteHotBrush}"
                  StrokeThickness="4.8"
                  Opacity="0.98">
                <Path.Effect>
                    <BlurEffect Radius="2.2" />
                </Path.Effect>
            </Path>
            <Path Data="M 72,359 C 163,343 215,326 271,300 C 342,267 404,247 461,237"
                  Stroke="#B5FF8B31"
                  StrokeThickness="2.6"
                  Opacity="0.8" />
            <Path Data="M 191,323 C 220,368 305,380 353,321"
                  Stroke="#4AFF8F38"
                  StrokeThickness="16">
                <Path.Effect>
                    <BlurEffect Radius="15" />
                </Path.Effect>
            </Path>
            <Path Data="M 194,319 C 226,359 301,369 347,318"
                  Stroke="#C8FFD0A0"
                  StrokeThickness="4"
                  Opacity="0.9">
                <Path.Effect>
                    <BlurEffect Radius="3" />
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- The shell drag image cannot be transformed by WPF, so render a lens-warped
             file proxy inside the gravity field to make the dragged object bend visibly. -->
        <Line x:Name="DragGravityTrail"
              Stroke="#B8FFD29A"
              StrokeThickness="2"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              Opacity="0"
              IsHitTestVisible="False">
            <Line.Effect>
                <BlurEffect Radius="3" />
            </Line.Effect>
        </Line>
        <Border x:Name="FileDragProxy"
                Width="68"
                Height="46"
                CornerRadius="7"
                Background="#E81A120D"
                BorderBrush="#FFFFD09A"
                BorderThickness="1.4"
                Opacity="0"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FileDragProxyScale" />
                    <SkewTransform x:Name="FileDragProxySkew" />
                    <RotateTransform x:Name="FileDragProxyRotation" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0"
                      Width="20"
                      Height="26"
                      Stretch="Fill"
                      Fill="#FFFFE4BD"
                      Data="M 2,0 L 13,0 L 20,7 L 20,26 L 2,26 Z M 13,0 L 13,7 L 20,7"
                      Opacity="0.92" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileDragExtension"
                               Text="FILE"
                               Foreground="#FFFFFFFF"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FileDragCount"
                               Text="1 ITEM"
                               Margin="0,2,0,0"
                               Foreground="#CCFFC684"
                               FontFamily="Consolas"
                               FontSize="7.5" />
                </StackPanel>
            </Grid>
            <Border.Effect>
                <DropShadowEffect Color="#FFFF8A32"
                                  BlurRadius="13"
                                  ShadowDepth="0"
                                  Opacity="0.72" />
            </Border.Effect>
        </Border>

        <!-- Feedback overlays are driven by the single render timer. -->
        <Ellipse x:Name="SuccessFlash"
                 Width="170"
                 Height="170"
                 Canvas.Left="175"
                 Canvas.Top="175"
                 Fill="#55FFF4DB"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="28" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="FailureHalo"
                 Width="170"
                 Height="170"
                 Canvas.Left="175"
                 Canvas.Top="175"
                 Fill="Transparent"
                 Stroke="#FFFF5B32"
                 StrokeThickness="8"
                 Opacity="0"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="8" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="DropPulse"
                 Width="148"
                 Height="148"
                 Canvas.Left="186"
                 Canvas.Top="186"
                 Fill="Transparent"
                 Stroke="#FFFFF4DF"
                 StrokeThickness="3"
                 Opacity="0"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DropPulseScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Fixed 132 px interaction target; decorative layers never intercept input. -->
        <Ellipse x:Name="EventHorizon"
                 Width="132"
                 Height="132"
                 Canvas.Left="194"
                 Canvas.Top="194"
                 Fill="#01000000"
                 Cursor="SizeAll"
                 MouseLeftButtonDown="OnEventHorizonMouseLeftButtonDown" />

        <!-- Temporary instrument-style status, never a permanent card. -->
        <Border x:Name="StatusBadge"
                Canvas.Left="105"
                Canvas.Top="444"
                Width="310"
                Height="52"
                Background="#B2120E0B"
                BorderBrush="#6AE9A566"
                BorderThickness="1,0,1,0"
                Opacity="0"
                IsHitTestVisible="False">
            <Grid Margin="12,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="2"
                        Margin="0,3,4,3"
                        HorizontalAlignment="Left"
                        Background="#FFFFA44D" />
                <StackPanel Grid.Column="1" Margin="5,0,8,0">
                    <TextBlock x:Name="StatusLabel"
                               Text="GRAVITY LOCK"
                               Foreground="#CCFFB86A"
                               FontFamily="Consolas"
                               FontSize="9"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,2,0,0"
                               Foreground="#FFF8E7D3"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Canvas Grid.Column="2" Width="31" Height="36" Opacity="0.8">
                    <Rectangle Width="2" Height="7" Canvas.Left="2" Canvas.Top="25" Fill="#99FFBD78" />
                    <Rectangle Width="2" Height="12" Canvas.Left="8" Canvas.Top="20" Fill="#AAFFC180" />
                    <Rectangle Width="2" Height="18" Canvas.Left="14" Canvas.Top="14" Fill="#BBFFD09D" />
                    <Rectangle Width="2" Height="25" Canvas.Left="20" Canvas.Top="7" Fill="#DDFFE1BE" />
                    <Line X1="0" Y1="33" X2="28" Y2="33" Stroke="#55FFC98B" StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Border>
    </Canvas>
</Window>
