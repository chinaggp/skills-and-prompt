<Window x:Class="WindowsBlackHole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Black Hole"
        Width="520"
        Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop">
    <Window.Resources>
        <LinearGradientBrush x:Key="HotMatterBrush"
                             StartPoint="0,0.55"
                             EndPoint="1,0.35">
            <GradientStop Color="#00FF6A18" Offset="0" />
            <GradientStop Color="#99FF7A22" Offset="0.18" />
            <GradientStop Color="#FFFFB45D" Offset="0.42" />
            <GradientStop Color="#FFFFF1D5" Offset="0.62" />
            <GradientStop Color="#FFFF8A2B" Offset="0.82" />
            <GradientStop Color="#00FF5A12" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WhiteHotBrush"
                             StartPoint="0,0.65"
                             EndPoint="1,0.25">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#88FFD6A4" Offset="0.22" />
            <GradientStop Color="#FFFFFFFF" Offset="0.52" />
            <GradientStop Color="#FFFFD6A2" Offset="0.73" />
            <GradientStop Color="#00FF7C25" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GridBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#006FA3B8" Offset="0" />
            <GradientStop Color="#436E8A93" Offset="0.34" />
            <GradientStop Color="#5CBE8C62" Offset="0.57" />
            <GradientStop Color="#006E8290" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PhotonGlowBrush"
                             StartPoint="0,1"
                             EndPoint="1,0">
            <GradientStop Color="#00FF6818" Offset="0" />
            <GradientStop Color="#8AFF8A30" Offset="0.22" />
            <GradientStop Color="#D8FFD39A" Offset="0.58" />
            <GradientStop Color="#7AFFF4DB" Offset="0.78" />
            <GradientStop Color="#00FF9A43" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PhotonArcBrush"
                             StartPoint="0,1"
                             EndPoint="1,0">
            <GradientStop Color="#10FF7A22" Offset="0" />
            <GradientStop Color="#C8FFB75F" Offset="0.28" />
            <GradientStop Color="#FFFFF5E3" Offset="0.63" />
            <GradientStop Color="#E8FFD399" Offset="0.78" />
            <GradientStop Color="#18FF8A2E" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Canvas x:Name="RootCanvas"
            Width="520"
            Height="520"
            Background="Transparent"
            ClipToBounds="True">
        <!-- Sparse star dust. The transparent window edge remains visually empty. -->
        <Canvas x:Name="DustLayer"
                Width="520"
                Height="520"
                IsHitTestVisible="False"
                Opacity="0.58"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="DustRotation" />
                    <TranslateTransform x:Name="DustTranslation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="2" Height="2" Canvas.Left="91" Canvas.Top="108" Fill="#A8D9E8EF" />
            <Ellipse Width="1.4" Height="1.4" Canvas.Left="143" Canvas.Top="67" Fill="#88FFFFFF" />
            <Ellipse Width="2.6" Height="2.6" Canvas.Left="194" Canvas.Top="102" Fill="#B7FFC98A" />
            <Ellipse Width="1.2" Height="1.2" Canvas.Left="264" Canvas.Top="54" Fill="#77FFFFFF" />
            <Ellipse Width="2" Height="2" Canvas.Left="338" Canvas.Top="90" Fill="#9ED4E2EA" />
            <Ellipse Width="1.5" Height="1.5" Canvas.Left="423" Canvas.Top="122" Fill="#99FFD8AC" />
            <Ellipse Width="1.3" Height="1.3" Canvas.Left="463" Canvas.Top="199" Fill="#88FFFFFF" />
            <Ellipse Width="2.2" Height="2.2" Canvas.Left="445" Canvas.Top="331" Fill="#A7FFC278" />
            <Ellipse Width="1.4" Height="1.4" Canvas.Left="398" Canvas.Top="406" Fill="#75FFFFFF" />
            <Ellipse Width="2" Height="2" Canvas.Left="319" Canvas.Top="449" Fill="#89D6E8F2" />
            <Ellipse Width="1.2" Height="1.2" Canvas.Left="222" Canvas.Top="456" Fill="#80FFFFFF" />
            <Ellipse Width="2.3" Height="2.3" Canvas.Left="144" Canvas.Top="423" Fill="#9DFFC683" />
            <Ellipse Width="1.5" Height="1.5" Canvas.Left="72" Canvas.Top="377" Fill="#80FFFFFF" />
            <Ellipse Width="1.2" Height="1.2" Canvas.Left="55" Canvas.Top="231" Fill="#80C6D8E3" />
            <Ellipse Width="3" Height="3" Canvas.Left="112" Canvas.Top="270" Fill="#A9FFB865">
                <Ellipse.Effect>
                    <BlurEffect Radius="2" />
                </Ellipse.Effect>
            </Ellipse>
            <Path Data="M 83,150 C 129,126 162,121 204,123"
                  Stroke="#256B8290"
                  StrokeThickness="0.8" />
            <Path Data="M 351,394 C 391,373 419,343 444,305"
                  Stroke="#20C58B60"
                  StrokeThickness="0.8" />
        </Canvas>

        <!-- Curved spacetime grid, inspired by the reference image. -->
        <Canvas x:Name="GridLayer"
                Width="460"
                Height="460"
                Canvas.Left="30"
                Canvas.Top="30"
                Opacity="0.46"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="GridSkew" />
                    <RotateTransform x:Name="GridRotation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="422" Height="422" Canvas.Left="19" Canvas.Top="19"
                     Fill="Transparent" Stroke="{StaticResource GridBrush}" StrokeThickness="0.7" />
            <Ellipse Width="374" Height="374" Canvas.Left="43" Canvas.Top="43"
                     Fill="Transparent" Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Ellipse Width="324" Height="324" Canvas.Left="68" Canvas.Top="68"
                     Fill="Transparent" Stroke="{StaticResource GridBrush}" StrokeThickness="0.8" />
            <Ellipse Width="276" Height="276" Canvas.Left="92" Canvas.Top="92"
                     Fill="Transparent" Stroke="{StaticResource GridBrush}" StrokeThickness="0.85" />
            <Ellipse Width="232" Height="232" Canvas.Left="114" Canvas.Top="114"
                     Fill="Transparent" Stroke="{StaticResource GridBrush}" StrokeThickness="0.9" />
            <Ellipse Width="194" Height="194" Canvas.Left="133" Canvas.Top="133"
                     Fill="Transparent" Stroke="#4BB98357" StrokeThickness="0.9" />
            <Path Data="M 18,151 C 112,170 166,201 230,230 C 294,259 348,290 442,309"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 33,101 C 132,149 175,192 230,230 C 285,268 328,311 427,359"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 82,47 C 157,127 191,181 230,230 C 269,279 303,333 378,413"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 151,18 C 170,112 201,166 230,230 C 259,294 290,348 309,442"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 230,8 C 230,112 230,164 230,230 C 230,296 230,348 230,452"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 309,18 C 290,112 259,166 230,230 C 201,294 170,348 151,442"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 378,47 C 303,127 269,181 230,230 C 191,279 157,333 82,413"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
            <Path Data="M 427,101 C 328,149 285,192 230,230 C 175,268 132,311 33,359"
                  Stroke="{StaticResource GridBrush}" StrokeThickness="0.75" />
        </Canvas>

        <!-- Companion star and the matter stream feeding the main disk. -->
        <Canvas x:Name="CompanionLayer"
                Width="220"
                Height="160"
                Canvas.Left="34"
                Canvas.Top="274"
                Opacity="0.82"
                IsHitTestVisible="False">
            <Ellipse Width="96" Height="96" Canvas.Left="5" Canvas.Top="38"
                     Fill="#30FF6A18">
                <Ellipse.Effect>
                    <BlurEffect Radius="30" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="56" Height="56" Canvas.Left="24" Canvas.Top="57">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.67,0.52">
                        <GradientStop Color="#FFFFF0C8" Offset="0" />
                        <GradientStop Color="#FFFF9D3D" Offset="0.16" />
                        <GradientStop Color="#FF7B1C08" Offset="0.51" />
                        <GradientStop Color="#FF120704" Offset="0.82" />
                        <GradientStop Color="#00FF6B1C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FFFF7B22"
                                      BlurRadius="22"
                                      ShadowDepth="0"
                                      Opacity="0.9" />
                </Ellipse.Effect>
            </Ellipse>
            <Path Data="M 36,93 C 45,67 72,59 92,72 C 104,80 104,105 89,114"
                  Stroke="#D9FFB058"
                  StrokeThickness="2.2"
                  Fill="Transparent" />
            <Path Data="M 70,87 C 112,83 148,74 218,45"
                  Stroke="#4AFF7A20"
                  StrokeThickness="20">
                <Path.Effect>
                    <BlurEffect Radius="14" />
                </Path.Effect>
            </Path>
            <Path Data="M 68,87 C 116,83 158,70 220,43"
                  Stroke="{StaticResource HotMatterBrush}"
                  StrokeThickness="6">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MatterStreamScale"
                                        CenterX="70"
                                        CenterY="87"
                                        ScaleX="1"
                                        ScaleY="1" />
                        <SkewTransform x:Name="MatterStreamSkew"
                                       CenterX="70"
                                       CenterY="87" />
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Effect>
                    <BlurEffect Radius="3" />
                </Path.Effect>
            </Path>
            <Ellipse Width="8" Height="8" Canvas.Left="112" Canvas.Top="76" Fill="#D9FFB45C" />
            <Ellipse Width="5" Height="5" Canvas.Left="151" Canvas.Top="61" Fill="#B8FFE2B8" />
        </Canvas>

        <!-- Back half of the accretion disk; fluid paths replace regular ellipses. -->
        <Canvas x:Name="DistortionField"
                Width="520"
                Height="520"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FieldScale" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="FieldSkew" />
                    <RotateTransform x:Name="FieldRotation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Path Data="M 48,321 C 124,275 172,205 239,164 C 320,115 385,153 474,215"
                  Stroke="#48FF741C"
                  StrokeThickness="58">
                <Path.Effect>
                    <BlurEffect Radius="33" />
                </Path.Effect>
            </Path>
            <Path Data="M 54,322 C 125,277 174,211 241,171 C 314,127 386,154 470,215"
                  Stroke="{StaticResource HotMatterBrush}"
                  StrokeThickness="24"
                  Opacity="0.78">
                <Path.Effect>
                    <BlurEffect Radius="11" />
                </Path.Effect>
            </Path>
            <Path Data="M 67,321 C 137,278 181,220 242,180 C 310,135 379,160 456,211"
                  Stroke="{StaticResource WhiteHotBrush}"
                  StrokeThickness="8"
                  Opacity="0.93">
                <Path.Effect>
                    <BlurEffect Radius="4" />
                </Path.Effect>
            </Path>
            <Path Data="M 105,310 C 157,272 191,225 243,193 C 305,155 354,164 420,201"
                  Stroke="#BFFFF4D9"
                  StrokeThickness="2.4"
                  Opacity="0.9" />
            <Path Data="M 91,336 C 149,292 187,254 231,226"
                  Stroke="#9AFF7D25"
                  StrokeThickness="3"
                  Opacity="0.75" />
            <Path Data="M 282,173 C 337,145 398,172 454,217"
                  Stroke="#A8FF8A32"
                  StrokeThickness="3"
                  Opacity="0.75" />
        </Canvas>

        <!-- Diffuse lensing is carried by irregular soft photon clusters, not a continuous halo. -->
        <Canvas x:Name="LensGlow"
                Width="520"
                Height="520"
                Opacity="0.42"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="LensGlowParticleRotation" CenterX="260" CenterY="260" />
                    <TranslateTransform x:Name="LensGlowParticleTranslation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="38" Height="25" Canvas.Left="173" Canvas.Top="265" Fill="#20FF8B32">
                <Ellipse.Effect>
                    <BlurEffect Radius="19" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="28" Height="30" Canvas.Left="202" Canvas.Top="191" Fill="#1CFFB76B">
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="34" Height="22" Canvas.Left="276" Canvas.Top="172" Fill="#24FFF0D4">
                <Ellipse.Effect>
                    <BlurEffect Radius="18" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="24" Height="32" Canvas.Left="326" Canvas.Top="211" Fill="#22FF9A43">
                <Ellipse.Effect>
                    <BlurEffect Radius="15" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="31" Height="20" Canvas.Left="303" Canvas.Top="303" Fill="#20FFC06E">
                <Ellipse.Effect>
                    <BlurEffect Radius="17" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="27" Height="24" Canvas.Left="231" Canvas.Top="329" Fill="#1EFFF6E2">
                <Ellipse.Effect>
                    <BlurEffect Radius="16" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="22" Height="29" Canvas.Left="185" Canvas.Top="302" Fill="#1AFF8530">
                <Ellipse.Effect>
                    <BlurEffect Radius="15" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
        <Canvas x:Name="PhotonHalo"
                Width="520"
                Height="520"
                Opacity="0.58"
                IsHitTestVisible="False">
            <!-- Independent photon clusters keep the event horizon luminous without forming a synthetic arc. -->
            <Canvas Width="520" Height="520" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PhotonHaloOuterRotation" CenterX="260" CenterY="260" />
                        <TranslateTransform x:Name="PhotonHaloOuterTranslation" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Width="14" Height="14" Canvas.Left="299" Canvas.Top="170" Fill="#1CFFB56A">
                    <Ellipse.Effect>
                        <BlurEffect Radius="7" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="3.8" Height="3.8" Canvas.Left="304" Canvas.Top="175" Fill="#FFFFF5DF" />
                <Ellipse Width="3" Height="3" Canvas.Left="334" Canvas.Top="205" Fill="#DFFFF0C7" />
                <Ellipse Width="5" Height="5" Canvas.Left="343" Canvas.Top="244" Fill="#BFFF9E47" />
                <Ellipse Width="2.4" Height="2.4" Canvas.Left="324" Canvas.Top="292" Fill="#BFFFF8E7" />
                <Ellipse Width="4.2" Height="4.2" Canvas.Left="286" Canvas.Top="326" Fill="#D8FFA14B" />
                <Ellipse Width="2.8" Height="2.8" Canvas.Left="241" Canvas.Top="338" Fill="#CFFFF6D7" />
                <Ellipse Width="3.6" Height="3.6" Canvas.Left="197" Canvas.Top="314" Fill="#CFFF9B42" />
                <Ellipse Width="2.2" Height="2.2" Canvas.Left="174" Canvas.Top="270" Fill="#AFFFF8E4" />
                <Ellipse Width="4.4" Height="4.4" Canvas.Left="188" Canvas.Top="222" Fill="#C8FF9137" />
                <Ellipse Width="2.6" Height="2.6" Canvas.Left="224" Canvas.Top="188" Fill="#BFFFF2CE" />
            </Canvas>
            <Canvas Width="520" Height="520" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PhotonHaloInnerRotation" CenterX="260" CenterY="260" />
                        <TranslateTransform x:Name="PhotonHaloInnerTranslation" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Width="10" Height="10" Canvas.Left="278" Canvas.Top="191" Fill="#1EFFE0A7">
                    <Ellipse.Effect>
                        <BlurEffect Radius="5" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="3.4" Height="3.4" Canvas.Left="282" Canvas.Top="195" Fill="#FFFFF9EC" />
                <Ellipse Width="2.4" Height="2.4" Canvas.Left="309" Canvas.Top="215" Fill="#E5FFC06E" />
                <Ellipse Width="3.2" Height="3.2" Canvas.Left="319" Canvas.Top="251" Fill="#DFFFF4D7" />
                <Ellipse Width="2.2" Height="2.2" Canvas.Left="300" Canvas.Top="284" Fill="#D7FF9A44" />
                <Ellipse Width="3.8" Height="3.8" Canvas.Left="265" Canvas.Top="302" Fill="#CFFFE9BD" />
                <Ellipse Width="2.5" Height="2.5" Canvas.Left="228" Canvas.Top="294" Fill="#C5FF9D48" />
                <Ellipse Width="3" Height="3" Canvas.Left="203" Canvas.Top="267" Fill="#D8FFFFEE" />
                <Ellipse Width="2" Height="2" Canvas.Left="207" Canvas.Top="232" Fill="#BFFFF0CC" />
                <Ellipse Width="3.6" Height="3.6" Canvas.Left="237" Canvas.Top="204" Fill="#CFFF963B" />
            </Canvas>
            <Canvas Width="520" Height="520" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PhotonHaloSparkRotation" CenterX="260" CenterY="260" />
                        <TranslateTransform x:Name="PhotonHaloSparkTranslation" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse Width="2" Height="2" Canvas.Left="319" Canvas.Top="186" Fill="#FFFFFBF1" />
                <Ellipse Width="2.8" Height="2.8" Canvas.Left="349" Canvas.Top="225" Fill="#EFFFF1D4" />
                <Ellipse Width="1.8" Height="1.8" Canvas.Left="332" Canvas.Top="280" Fill="#DFFFF7E6" />
                <Ellipse Width="2.6" Height="2.6" Canvas.Left="302" Canvas.Top="315" Fill="#DFFF9D45" />
                <Ellipse Width="1.7" Height="1.7" Canvas.Left="248" Canvas.Top="332" Fill="#EFFFF9EA" />
                <Ellipse Width="2.4" Height="2.4" Canvas.Left="194" Canvas.Top="291" Fill="#D5FF9840" />
                <Ellipse Width="1.9" Height="1.9" Canvas.Left="178" Canvas.Top="242" Fill="#DFFFF5DC" />
                <Ellipse Width="2.5" Height="2.5" Canvas.Left="210" Canvas.Top="199" Fill="#CFFF9A42" />
                <Ellipse Width="1.6" Height="1.6" Canvas.Left="261" Canvas.Top="180" Fill="#EFFFFBF0" />
            </Canvas>
        </Canvas>
        <Canvas x:Name="PhotonRing"
                Width="520"
                Height="520"
                Opacity="0.9"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="PhotonRingParticleRotation" CenterX="260" CenterY="260" />
                    <TranslateTransform x:Name="PhotonRingParticleTranslation" />
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="5.2" Height="5.2" Canvas.Left="257.4" Canvas.Top="175.4" Fill="#FFFFFAEE">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="2.2" Height="2.2" Canvas.Left="270" Canvas.Top="174.6" Fill="#DFFFF3D8" />
            <Ellipse Width="3.2" Height="3.2" Canvas.Left="279.4" Canvas.Top="180.2" Fill="#EFFFF4D4" />
            <Ellipse Width="4.4" Height="4.4" Canvas.Left="290.7" Canvas.Top="178.3" Fill="#E5FF9E47" />
            <Ellipse Width="2.6" Height="2.6" Canvas.Left="300.2" Canvas.Top="186.8" Fill="#F5FFFFF0" />
            <Ellipse Width="3.8" Height="3.8" Canvas.Left="306.8" Canvas.Top="194.6" Fill="#DFFF9A42" />
            <Ellipse Width="4.8" Height="4.8" Canvas.Left="319.1" Canvas.Top="196.1" Fill="#EFFFF7E5">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="2.1" Height="2.1" Canvas.Left="324" Canvas.Top="209" Fill="#CFFFF1D2" />
            <Ellipse Width="3.4" Height="3.4" Canvas.Left="331" Canvas.Top="216.3" Fill="#E5FFAB57" />
            <Ellipse Width="2.5" Height="2.5" Canvas.Left="332.7" Canvas.Top="228.1" Fill="#DFFF963B" />
            <Ellipse Width="4.6" Height="4.6" Canvas.Left="340.8" Canvas.Top="235.4" Fill="#F2FFFFF2" />
            <Ellipse Width="2.8" Height="2.8" Canvas.Left="340.9" Canvas.Top="247.8" Fill="#CFFF9740" />
            <Ellipse Width="4.1" Height="4.1" Canvas.Left="342" Canvas.Top="258" Fill="#FFFFFAEE">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="2" Height="2" Canvas.Left="338.3" Canvas.Top="269.4" Fill="#DFFFF3D8" />
            <Ellipse Width="3.6" Height="3.6" Canvas.Left="341.3" Canvas.Top="280.5" Fill="#EFFFF4D4" />
            <Ellipse Width="4.9" Height="4.9" Canvas.Left="333.3" Canvas.Top="288.9" Fill="#E5FF9E47" />
            <Ellipse Width="2.4" Height="2.4" Canvas.Left="332.4" Canvas.Top="301.3" Fill="#F5FFFFF0" />
            <Ellipse Width="3.1" Height="3.1" Canvas.Left="322.7" Canvas.Top="307.8" Fill="#DFFF9A42" />
            <Ellipse Width="4.3" Height="4.3" Canvas.Left="319.4" Canvas.Top="319.4" Fill="#EFFFF7E5">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.3" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="2.7" Height="2.7" Canvas.Left="309.2" Canvas.Top="324.5" Fill="#CFFFF1D2" />
            <Ellipse Width="3.9" Height="3.9" Canvas.Left="298" Canvas.Top="327.3" Fill="#E5FFAB57" />
            <Ellipse Width="2.2" Height="2.2" Canvas.Left="291.8" Canvas.Top="338.4" Fill="#DFFF963B" />
            <Ellipse Width="5" Height="5" Canvas.Left="278.7" Canvas.Top="336.7" Fill="#F2FFFFF2" />
            <Ellipse Width="2.6" Height="2.6" Canvas.Left="269.7" Canvas.Top="342" Fill="#CFFF9740" />
            <Ellipse Width="3.3" Height="3.3" Canvas.Left="258.4" Canvas.Top="339.4" Fill="#FFFFFAEE">
                <Ellipse.Effect>
