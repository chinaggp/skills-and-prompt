  <ItemGroup>
    <ProjectReference Include="..\WindowsBlackHole.Core\WindowsBlackHole.Core.csproj" />
    <ProjectReference Include="..\WindowsBlackHole.Shell\WindowsBlackHole.Shell.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\WindowsBlackHole.Renderer\build\Release\WindowsBlackHole.Renderer.dll')">
    <Content Include="..\WindowsBlackHole.Renderer\build\Release\WindowsBlackHole.Renderer.dll">
